{
  "name": "mansour-vision",
  "version": "0.1.0",
  "private": true,
  "description": "MANSOUR Vision — AI-Powered Event Command & Control Platform",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/command-center"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/command-center",
    "build": "npm run build --workspace apps/command-center",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\"",
    "contracts:generate": "node scripts/generate-contract-types.mjs",
    "contracts:check": "node scripts/generate-contract-types.mjs --check"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.3",
    "prettier": "^3.4.2"
  }
}
