{
  "$defs": {
    "Severity": {
      "description": "Alert severity (Operational SRS \u00a710).\n\n`EMERGENCY` is never suppressed, never batched, never subject to quiet hours,\nand never disarmed by a schedule. That is enforced downstream; the ordering\nhere is what makes it checkable.",
      "enum": [
        "info",
        "warning",
        "critical",
        "emergency"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A zone or line predicate was satisfied. Feeds `alert-engine`.\n\nThis is not an alert. It is the observation from which the alert engine may\nraise one, subject to cooldown, arming, and clustering. The distinction is\nthe reason the worker does not need to know about cooldowns at all.",
  "properties": {
    "camera_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "config_version": {
      "minimum": 0,
      "type": "integer"
    },
    "context": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "type": "object"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dedup_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "type": "string"
    },
    "event_type": {
      "const": "rule.trigger",
      "default": "rule.trigger",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "rule": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "type": "integer"
    },
    "scope_key": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "zone_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "producer",
    "rule",
    "severity",
    "scope_key",
    "dedup_key",
    "config_version"
  ],
  "title": "RuleTrigger",
  "type": "object"
}
